# Copy to .env (never commit .env). Names only — no real values here.

# ---- Mobile (Expo) ----
# EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets in them.
# Optional backend for feedback submission. Leave empty to disable network features.
EXPO_PUBLIC_API_BASE_URL=

# ---- Backend (FastAPI) ----
# SQLite for local development; PostgreSQL in deployment, e.g.
# postgresql+psycopg://USER:PASSWORD@HOST:5432/signspeak
DATABASE_URL=sqlite:///./signspeak-dev.db
# Directory containing a model pack (manifest.json + weights). Empty = no server model.
SIGNSPEAK_MODEL_DIR=
# Comma-separated list of allowed CORS origins. Empty = none.
SIGNSPEAK_ALLOWED_ORIGINS=
# Maximum accepted request body size in bytes.
SIGNSPEAK_MAX_REQUEST_BYTES=1000000

# ---- ML ----
# Root of the locally mounted, authorized dataset (see docs/dataset.md).
SIGNSPEAK_DATASET_ROOT=./ml/dataset
